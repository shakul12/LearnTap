# Supabase — from your project's Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Daily.co — from https://dashboard.daily.co/developers
DAILY_API_KEY=your-daily-api-key

# Resend (teacher email notifications) — from https://resend.com/api-keys
# Optional: without it, notification emails are silently skipped.
RESEND_API_KEY=your-resend-api-key
# Sender — must be on a domain you've verified in Resend. Until then the
# Resend sandbox sender only delivers to your own account email.
EMAIL_FROM="LearnTap <notify@learntap.app>"
# Base URL used in email links.
NEXT_PUBLIC_APP_URL=https://learntap.app
